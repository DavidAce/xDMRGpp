#include "../matrix_vector_product.h"
#include "tensors/site/env/EnvEne.h"
#include "tensors/site/env/EnvVar.h"

using Scalar = @SCALAR@;

template<typename ScalarT>
requires(sfinae::is_any_v<typename Eigen::NumTraits<ScalarT>::Real, fp32, fp64, fp128>)
void tools::common::contraction::matrix_vector_product(Eigen::Tensor<ScalarT, 3>       &res,
                                                       const Eigen::Tensor<ScalarT, 3> &mps,
                                                       const Eigen::Tensor<ScalarT, 4> &mpo,
                                                       const EnvEne<ScalarT>           &envL,
                                                       const EnvEne<ScalarT>           &envR) {
    const internal::InfoH1Mv h1info = internal::get_info_h1mv();
    auto precision_active           = ContractionPrecision::X2_AS_NEEDED;

    if(mpo.dimensions() == h1info.H1_local_dims) precision_active = h1info.precision;
    if(internal::local_dims_are_unset(h1info.H1_local_dims) and h1info.precision != ContractionPrecision::X2_AS_NEEDED) precision_active = h1info.precision;
    if(precision_active == ContractionPrecision::X2) {
        matrix_vector_product(res, mps, mpo, envL.template get_blkx2_as<ScalarT>(), envR.template get_blkx2_as<ScalarT>());
    } else {
        matrix_vector_product(res, mps, mpo, envL.template get_block_as<ScalarT>(), envR.template get_block_as<ScalarT>());
    }
}

template<typename ScalarT>
requires(sfinae::is_any_v<typename Eigen::NumTraits<ScalarT>::Real, fp32, fp64, fp128>)
void tools::common::contraction::matrix_vector_product(Eigen::Tensor<ScalarT, 3>       &res,
                                                       const Eigen::Tensor<ScalarT, 3> &mps,
                                                       const Eigen::Tensor<ScalarT, 4> &mpo,
                                                       const EnvVar<ScalarT>           &envL,
                                                       const EnvVar<ScalarT>           &envR) {
    const internal::InfoH2Mv h2info = internal::get_info_h2mv();
    auto precision_active           = ContractionPrecision::X2_AS_NEEDED;

    if(mpo.dimensions() == h2info.H2_local_dims) precision_active = h2info.precision;
    if(internal::local_dims_are_unset(h2info.H2_local_dims) and h2info.precision != ContractionPrecision::X2_AS_NEEDED) precision_active = h2info.precision;
    if(precision_active == ContractionPrecision::X2) {
        matrix_vector_product(res, mps, mpo, envL.template get_blkx2_as<ScalarT>(), envR.template get_blkx2_as<ScalarT>());
    } else {
        matrix_vector_product(res, mps, mpo, envL.template get_block_as<ScalarT>(), envR.template get_block_as<ScalarT>());
    }
}

template void tools::common::contraction::matrix_vector_product(Eigen::Tensor<Scalar, 3>       &res,
                                                                const Eigen::Tensor<Scalar, 3> &mps,
                                                                const Eigen::Tensor<Scalar, 4> &mpo,
                                                                const EnvEne<Scalar>           &envL,
                                                                const EnvEne<Scalar>           &envR);
template void tools::common::contraction::matrix_vector_product(Eigen::Tensor<Scalar, 3>       &res,
                                                                const Eigen::Tensor<Scalar, 3> &mps,
                                                                const Eigen::Tensor<Scalar, 4> &mpo,
                                                                const EnvVar<Scalar>           &envL,
                                                                const EnvVar<Scalar>           &envR);
